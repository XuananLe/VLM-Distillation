\contentsline {table}{\numberline {4.1}{\ignorespaces Dataset split sizes for the three benchmarks.}}{35}{table.caption.33}%
\contentsline {table}{\numberline {4.2}{\ignorespaces Training configuration for the current main distillation script.}}{37}{table.caption.35}%
\contentsline {table}{\numberline {4.3}{\ignorespaces Baseline groups used in the evaluation chapter. The grouping clarifies whether a method tests matched-token KD, cross-tokenizer transfer, or adaptive multi-teacher weighting.\relax }}{38}{table.caption.36}%
\addvspace {10\p@ }
\contentsline {table}{\numberline {5.1}{\ignorespaces Original benchmark results of the two SmolVLM students evaluated with VLM-Eval-Kit. These scores define the reference point that all later fine-tuning and distillation gains should be measured against.\relax }}{41}{table.caption.37}%
\contentsline {table}{\numberline {5.2}{\ignorespaces Original benchmark results of the teacher and large reference models used in this thesis. The table shows that the selected teachers cover a wide performance range, with several models far above the compact SmolVLM students.\relax }}{42}{table.caption.38}%
\contentsline {table}{\numberline {5.3}{\ignorespaces TextVQA comparison across original models, fine-tuning, distillation baselines, and GRACE. The main question here is whether adaptive multi-teacher weighting improves over same-family KD and over static multi-teacher baselines.\relax }}{43}{table.caption.39}%
\contentsline {table}{\numberline {5.4}{\ignorespaces DocVQA comparison across original models, fine-tuning, distillation baselines, and GRACE. The table is most useful for checking whether the same teacher pool helps more when document layout and OCR quality matter strongly.\relax }}{44}{table.caption.40}%
\contentsline {table}{\numberline {5.5}{\ignorespaces ChartQA comparison across original models, fine-tuning, distillation baselines, and GRACE. The strongest gain appears here, which suggests that adaptive teacher weighting is especially useful when numerical reasoning and chart reading are combined.\relax }}{45}{table.caption.41}%
\contentsline {table}{\numberline {5.6}{\ignorespaces Teacher-assignment study on SmolVLM-500M. Moving from one teacher to a heterogeneous pool already helps, but the strongest gains come from the GRACE weighting rule rather than from teacher count alone.\relax }}{48}{table.caption.44}%
